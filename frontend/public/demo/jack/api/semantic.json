":"订单明细","description":"一行一个商品。pay_amount 为分摊订单优惠后的实付，同一订单的明细实付之和等于订单实付。","columns":[{"name":"item_id","label":"明细 ID","description":"","sensitive":false,"requires":null,"readable":true},{"name":"order_id","label":"订单号","description":"","sensitive":false,"requires":null,"readable":true},{"name":"product_id","label":"商品 ID","description":"","sensitive":false,"requires":null,"readable":true},{"name":"quantity","label":"件数","description":"","sensitive":false,"requires":null,"readable":true},{"name":"unit_price","label":"成交单价","description":"","sensitive":false,"requires":null,"readable":true},{"name":"line_amount","label":"原价小计","description":"","sensitive":false,"requires":null,"readable":true},{"name":"pay_amount","label":"分摊后实付","description":"","sensitive":false,"requires":null,"readable":true}]},{"name":"customers","alias":"c","label":"会员","description":"会员档案。region_id 为注册地，和订单的履约区域不是同一个概念。","columns":[{"name":"customer_id","label":"客户 ID","description":"","sensitive":false,"requires":null,"readable":true},{"name":"region_id","label":"注册区域 ID","description":"","sensitive":false,"requires":null,"readable":true},{"name":"city","label":"注册城市","description":"","sensitive":false,"requires":null,"readable":true},{"name":"member_level","label":"会员等级","description":"","sensitive":false,"requires":null,"readable":true},{"name":"age_band","label":"年龄段","description":"","sensitive":false,"requires":null,"readable":true},{"name":"signup_date","label":"注册日期","description":"","sensitive":false,"requires":null,"readable":true},{"name":"phone","label":"手机号","description":"","sensitive":true,"requires":null,"readable":false}]},{"name":"products","alias":"p","label":"商品","description":"","columns":[{"name":"product_id","label":"商品 ID","description":"","sensitive":false,"requires":null,"readable":true},{"name":"product_name","label":"商品名称","description":"","sensitive":false,"requires":null,"readable":true},{"name":"category","label":"品类","description":"","sensitive":false,"requires"