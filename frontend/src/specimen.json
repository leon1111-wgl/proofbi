 "queries": [
  {
   "query_id": "q_68fbba109c57",
   "key": "q1",
   "title": "复购率",
   "sql": "SELECT\n  t.period AS period,\n  t.region AS region,\n  SUM(CASE WHEN t.orders_in_period >= 2 THEN 1 ELSE 0 END) AS repeat_buyers,\n  COUNT(*) AS buyer_count,\n  ROUND(\n    SUM(CASE WHEN t.orders_in_period >= 2 THEN 1 ELSE 0 END) * 1.0 / NULLIF(COUNT(*), 0),\n    4\n  ) AS repurchase_rate\nFROM (\n  SELECT\n    o.customer_id AS customer_id,\n    CASE\n      WHEN o.order_date BETWEEN '2026-09-01' AND '2026-09-30'\n      THEN '2026-09'\n      ELSE '2025-09'\n    END AS period,\n    r.region_name AS region,\n    COUNT(DISTINCT o.order_id) AS orders_in_period\n  FROM orders AS o\n  JOIN regions AS r\n    ON o.region_id = r.region_id\n  WHERE\n    o.status IN ('paid', 'refunded')\n    AND (\n      o.order_date BETWEEN '2026-09-01' AND '2026-09-30'\n      OR o.order_date BETWEEN '2025-09-01' AND '2025-09-30'\n    )\n  GROUP BY\n    o.customer_id,\n    CASE\n      WHEN o.order_date BETWEEN '2026-09-01' AND '2026-09-30'\n      THEN '2026-09'\n      ELSE '2025-09'\n    END,\n    r.region_name\n) AS t\nGROUP BY\n  t.period,\n  t.region\nORDER BY\n  period,\n  region\nLIMIT 1000",
   "columns": [
    "period",
    "region",
    "repeat_buyers",
    "buyer_count",
    "repurchase_rate"
   ],
