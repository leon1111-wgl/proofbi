# Copy to .env and edit. Every variable is optional; the defaults run fully offline.

# ---------- storage & auth ----------
# PROOFBI_DATABASE_URL=sqlite:///./data/proofbi.db      # app state: conversations, runs, SQL attempts, evals
# PROOFBI_WAREHOUSE_PATH=./data/warehouse.db            # synthetic warehouse, generated on first start
PROOFBI_JWT_SECRET=please-replace-with-a-long-random-string-32-bytes-min
PROOFBI_DEMO=1                    # 0 in production: no demo accounts on the login page, no seeded eval run
# PROOFBI_TODAY=2026-10-01        # anchor for 上个月 / 近 30 天 (defaults to the semantic layer's calendar)

# ---------- model ----------
# mock = offline deterministic model (rules planner + template SQL), used by tests and CI
PROOFBI_LLM_PROVIDER=mock

# 混元 / 豆包 / DeepSeek share one OpenAI-compatible adapter:
# PROOFBI_LLM_PROVIDER=openai_compat
# PROOFBI_LLM_PRESET=hunyuan        # hunyuan | doubao | deepseek   (or set PROOFBI_LLM_BASE_URL)
# PROOFBI_LLM_API_KEY=...
# PROOFBI_LLM_MODEL=<model or endpoint id from the vendor console>
# PROOFBI_PLANNER=auto              # rules | llm | auto (llm when a real provider is set)
# PROOFBI_SQL_WRITER=auto           # template | llm | auto

# ---------- query limits ----------
# PROOFBI_MAX_ROWS=1000
# PROOFBI_QUERY_TIMEOUT_MS=3000
# PROOFBI_MAX_CORRECTIONS=2

# ---------- channels ----------
# PROOFBI_WECOM_WEBHOOK_KEY=...     # 企业微信群机器人 key, for the daily report
# PROOFBI_PUBLIC_URL=http://localhost:8000   # links in the report point here
